# Copy to .env and fill in your values: cp .env.example .env
# Used by Docker Compose (docker compose up) and by backend when running locally.

# PostgreSQL (used by postgres service and by backend in Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=testmyknowledge

# OpenAI (required for quiz generation)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Backend security (change in production)
SECRET_KEY=your-secret-key-change-in-production
