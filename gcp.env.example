# Copy to gcp.env and fill in. Do not commit gcp.env.
# Used by: make gcp-db-create gcp-schema gcp-deploy-backend gcp-build-frontend gcp-deploy-frontend

# GCP project ID (lowercase, from Console or: gcloud projects list)
# GCP_PROJECT=skillora-app

# Cloud SQL instance name (only if different from default 'skillora-db')
# CLOUD_SQL_NAME=your-instance-name

# Cloud SQL (required for gcp-db-create, gcp-schema, gcp-deploy-backend)
DB_PASSWORD=your-strong-db-password

# OpenAI (required for gcp-deploy-backend)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Backend auth (required for gcp-deploy-backend)
SECRET_KEY=your-production-secret-key

# Set after first backend deploy (required for gcp-build-frontend, gcp-deploy-frontend)
# BACKEND_URL=https://skillora-backend-xxxxx-uc.a.run.app

# Optional: set after frontend deploy to restrict CORS (then redeploy backend)
# FRONTEND_URL=https://skillora-frontend-xxxxx-uc.a.run.app
