# Copy to deploy/.env.production on your machine and on the server:
#   cp deploy/.env.example deploy/.env.production
#
# Used by: scripts/build-and-push-images.sh (DOCKER_USER, REACT_APP_API_URL)
#          docker compose --env-file deploy/.env.production -f docker-compose.pull.yml

# --- Docker Hub (required for build/push + pull deploy) ---
# Replace with your Docker Hub username (same as docker login). Do not leave YOUR_DOCKERHUB_USERNAME.
# Or: export DOCKER_USER=you  then make docker-hub-build-push (overrides the placeholder).
DOCKER_USER=YOUR_DOCKERHUB_USERNAME

# --- Frontend build-time (browser must reach this API URL; set BEFORE make docker-hub-build-push) ---
# NEVER use localhost for production — the user's browser would call their own machine.
# Droplet: API is exposed on host port 9081 (not 8080; that is ERP).
# Replace with your real URL, e.g. http://139.59.33.5:9081 or https://api.yourdomain.com
REACT_APP_API_URL=http://YOUR_DROPLET_IP:9081

# --- PostgreSQL (Skillora dedicated DB; do not use ERP database name) ---
POSTGRES_USER=skillora
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=testmyknowledge

# --- Backend (runtime on server) ---
OPENAI_API_KEY=sk-your-openai-key
# GPT-5.4 family (recommended): gpt-5.4-mini (default in code) = best cost/quality for quiz JSON.
# Upgrade: gpt-5.4 for hardest STEM/contests. Budget/simple recall: gpt-5.4-nano.
# Legacy: gpt-4o, gpt-4o-mini (set OPENAI_REASONING_EFFORT empty or omit for non–GPT-5 ids).
OPENAI_MODEL=gpt-5.4-mini
# GPT-5.x only: none | low | medium | high | xhigh. Use medium/high for proofs & hard logic (no temperature then).
# none = fastest; pairs with temperature in code. For gpt-4o*, leave empty: OPENAI_REASONING_EFFORT=
OPENAI_REASONING_EFFORT=none
SECRET_KEY=change-me-use-openssl-rand-hex-32
# Exact browser origins (comma-separated). Must match the address bar: scheme + host + port.
# On the droplet, include your public IP or domain — "localhost" alone does NOT match http://IP:9080
# Example: CORS_ORIGINS=http://139.59.33.5:9080
# Optional: add http://localhost:9080 only if you test the UI locally against this API.
CORS_ORIGINS=http://139.59.33.5:9080
DEBUG=false
